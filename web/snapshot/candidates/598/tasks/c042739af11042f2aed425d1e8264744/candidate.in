&CONTROL
  calculation='relax',
  outdir='./Outputs',
  prefix='candidate',
  pseudo_dir='./Pseudopotentials',
  verbosity='low',
  tprnfor=.true.,
  tstress=.true.,
  forc_conv_thr=1.0d-4,
  disk_io='low',
/
&SYSTEM
  ibrav = 0
  A =   12.00000
  nat = 1
  ntyp = 1
  ecutwfc=60,
  ecutrho=600,
  input_dft='pbe',
  vdw_corr='dft-d3',
  assume_isolated='mt',
  occupations='smearing',
  smearing='m-p',
  degauss=0.005d0,
/

&ELECTRONS
  conv_thr=1d-07,
  mixing_beta=0.15d0,
  electron_maxstep=200,
/
&IONS
  ion_dynamics='bfgs',
/
